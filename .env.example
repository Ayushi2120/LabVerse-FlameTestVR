# ==============================================================================
# LABVERSE ATOM-8 AI Chemistry Lab Assistant Configuration
# ==============================================================================

# AI Provider to use: "gemini" (recommended) or "openai"
AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Recommended - Free Tier Available)
# Obtain your free Gemini API key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Specific Gemini model (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Alternative: OpenAI / OpenAI-Compatible API
# Obtain key at: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 3. Backend Server Port
# ------------------------------------------------------------------------------
PORT=3001
